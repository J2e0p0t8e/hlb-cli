const colors = [
    "\x1b[1;37m", // Blanc brillant
    "\x1b[0;37m", // Gris clair
    "\x1b[1;36m", // Cyan brillant
    "\x1b[0;36m"  // Cyan
];

function rainbow(str) {
    let result = '';
    const lines = str.split('\n');
    for (let i = 0; i < lines.length; i++) {
        const color = colors[i % colors.length];
        result += color + lines[i] + '\x1b[0m\n';
    }
    return result;
}

