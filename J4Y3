// Démarrer
startShell();

rl.on('line', async (line) => {
    const args = line.trim().split(/\s+/);
    const command = args[0].toLowerCase();

    if (!command) {
        rl.prompt();
        return;
    }

    switch (command) {
        case 'agent':
            if (args.length < 3) {
                console.error("Usage: agent <challenge_id> <chemin_vers_outil> [args...]");
            } else {
                const challengeId = parseInt(args[1]);
                const agentCmd = args[2];
                const agentArgs = args.slice(3);
                
                if (isNaN(challengeId)) {
                    console.error("L'ID de la mission doit être un nombre.");
                } else {
                    await runAgent(challengeId, agentCmd, agentArgs);
                }
            }
            break;
        case 'submit':
            if (args.length < 3) {
                console.error("Usage: submit <challenge_id> <flag>");
            } else {
                const challengeId = parseInt(args[1]);
                if (isNaN(challengeId)) {
                    console.error("L'ID de la mission doit être un nombre.");
                } else {
                    const flag = args.slice(2).join(' ');
                    await submitFlag(challengeId, flag);
                }
            }
            break;
        case 'map':
            await mapMissions();
            break;
        case 'change-key':
            if (fs.existsSync(configPath)) {
                try {
                    const cur = JSON.parse(fs.readFileSync(configPath, 'utf8'));
                    delete cur.licence_key;
                    fs.writeFileSync(configPath, JSON.stringify(cur, null, 2));
                } catch(e) {
                    fs.unlinkSync(configPath);
                }
            }
            console.log("\x1b[32m[hlb]\x1b[0m Clé de licence réinitialisée. Relancez `hlb` pour entrer votre nouvelle clé.");
            process.exit(0);
            break;
        case 'licence':
            if (args.length < 2) {
                console.error("Usage: licence <create|list|revoke|activate|change> [secret/args...]");
            } else if (args[1].toLowerCase() === 'change') {
                if (fs.existsSync(configPath)) {
                    try {
                        const cur = JSON.parse(fs.readFileSync(configPath, 'utf8'));
                        delete cur.licence_key;
                        fs.writeFileSync(configPath, JSON.stringify(cur, null, 2));
                    } catch(e) {
                        fs.unlinkSync(configPath);
                    }
                }
                console.log("\x1b[32m[hlb]\x1b[0m Clé de licence réinitialisée. Relancez `hlb` pour entrer votre nouvelle clé.");
                process.exit(0);
            } else if (args.length < 3) {
                console.error("Usage: licence <create|list|revoke|activate> <secret> [nom_du_pote|cle_hlb]");
            } else {
                const subAction = args[1].toLowerCase();
                const secret = args[2];
                const target = args.slice(3).join(' ');
                if (!['create', 'list', 'revoke', 'activate'].includes(subAction)) {
                    console.error("Action inconnue. Choix possibles : create, list, revoke, activate, change");
                } else {
                    await handleAdminLicence(secret, subAction, target);
                }
            }
            break;
        case 'help':
            printHelp();
            break;
        case 'exit':
        case 'quit':
        case 'q':
            console.log("Fermeture de hlb. Bon piratage ! 👩‍💻👨‍💻");
            process.exit(0);
            break;
        default:
            console.error(`Commande inconnue: '${command}'. Tapez 'help' pour voir les options.`);
            break;
    }
    
    // Un petit délai pour laisser l'affichage asynchrone se terminer si nécessaire
    setTimeout(() => {
        rl.prompt();
    }, 50);
}).on('close', () => {
    console.log("\nFermeture de hlb. Bon piratage ! 👩‍💻👨‍💻");
    process.exit(0);
});
