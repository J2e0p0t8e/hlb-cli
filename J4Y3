const { spawn } = require('child_process');

async function runAgent(challengeId, agentCmd, agentArgs) {
    return new Promise(async (resolve) => {
        let linkedWriteups = "";
        const linkIndex = agentArgs.indexOf('--link');
        if (linkIndex !== -1 && agentArgs.length > linkIndex + 1) {
            const linkedIds = agentArgs[linkIndex + 1].split(',');
            agentArgs.splice(linkIndex, 2); // On retire l'argument pour ne pas casser l'agent
            
            for (const id of linkedIds) {
                const trimId = id.trim();
                // 1. Chercher en BD (source partagée de la team)
                const rows = await loadWriteupFromDB(parseInt(trimId));
                if (rows) {
                    console.log(`\x1b[36m[hlb]\x1b[0m 📂 Mission ${trimId} : ${rows.length} writeup(s) chargé(s) depuis la BD.`);
                    rows.forEach((row, i) => {
                        linkedWriteups += `\n--- DEBUT ARCHIVE MISSION ${trimId} [v${i+1} — par ${row.author} le ${new Date(row.created_at).toLocaleDateString()}] ---\n${row.content}\n--- FIN ARCHIVE MISSION ${trimId} [v${i+1}] ---\n`;
                    });
                } else {
                    // 2. Fallback local
                    const filepath = path.join(process.cwd(), `Writeup_Mission_${trimId}.md`);
                    if (fs.existsSync(filepath)) {
                        console.log(`\x1b[33m[hlb]\x1b[0m 📂 Archive mission ${trimId} chargée depuis le disque local.`);
                        const content = fs.readFileSync(filepath, 'utf8');
                        linkedWriteups += `\n--- DEBUT ARCHIVE MISSION ${trimId} ---\n${content}\n--- FIN ARCHIVE MISSION ${trimId} ---\n`;
                    } else {
                        console.log(`\x1b[31m[hlb]\x1b[0m ⚠️  Aucun rapport trouvé pour la mission ${trimId} (ni en BD, ni en local).`);
                    }
                }
            }
        }


        console.log(`\x1b[33m[hlb]\x1b[0m Récupération des infos de la mission ${challengeId}...`);
        const mission = await getMissionDetails(challengeId);
        if (!mission) {
            console.error(`\x1b[31m[hlb] Impossible de trouver la mission ${challengeId}\x1b[0m`);
            resolve();
            return;
        }

        if (mission.view) {
            delete mission.view;
        }

        let handoverSection = "";
        if (linkedWriteups !== "") {
            handoverSection = `\n2.5. ARCHIVES ET RENSEIGNEMENTS PRÉCÉDENTS (HANDOVER)\n\nVoici les rapports d'investigation de missions précédentes. Analyse-les rapidement avant de commencer. Les mots de passe, clés, IP ou noms trouvés dans ces rapports peuvent être la clé pour résoudre ta mission actuelle.\n${linkedWriteups}\n`;
        }

        // Le system_prompt est récupéré depuis la BD via l'API de licence
        const basePrompt = config.system_prompt || '[ERREUR: system_prompt non chargé depuis la BD]';

        // Injection dynamique des données mission et du handover dans le prompt
        const promptTemplate = basePrompt
            .replace('{{MISSION_JSON}}', JSON.stringify(mission, null, 2))
            .replace('{{HANDOVER}}', handoverSection)
            .replace('{{USERNAME}}', os.userInfo().username)
            .replace('{{HOSTNAME}}', os.hostname());

        if (!agentArgs.includes('--dangerously-skip-permissions')) {
            agentArgs.push('--dangerously-skip-permissions');
        }

        // Pour agy en mode -p / --print, on augmente le timeout par défaut (5m -> 15m) pour laisser le temps de résoudre
        if (agentCmd === 'agy' && (agentArgs.includes('-p') || agentArgs.includes('--print') || agentArgs.includes('--prompt'))) {
            if (!agentArgs.includes('--print-timeout')) {
                agentArgs.push('--print-timeout', '15m');
            }
        }

        const hasPromptArg = agentArgs.some(arg => arg.includes('{PROMPT}'));
        const finalArgs = agentArgs.map(arg => arg.replace('{PROMPT}', promptTemplate));

        console.log(`\x1b[33m[hlb]\x1b[0m Lancement de l'agent IA : ${agentCmd} ${agentArgs.join(' ')}`);
        
        const agent = spawn(agentCmd, finalArgs, {
            stdio: ['pipe', 'pipe', 'pipe'],
            shell: false
        });

        // Gérer les erreurs si la commande n'existe pas ou crash
        agent.on('error', (err) => {
            console.error(`\x1b[31m[hlb]\x1b[0m Erreur au lancement de l'agent: ${err.message}`);
            resolve();
        });

        // Empêcher le crash "write EPIPE" si l'agent ferme immédiatement son entrée standard
        agent.stdin.on('error', (err) => {
            if (err.code !== 'EPIPE') {
                console.error(`\x1b[31m[hlb]\x1b[0m Erreur d'entrée (stdin): ${err.message}`);
            }
        });

        // Si le prompt n'a pas été passé en argument, on l'envoie sur l'entrée standard
        if (!hasPromptArg) {
            try {
                agent.stdin.write(promptTemplate + '\n');
            } catch (err) {
                // L'erreur sera aussi attrapée par agent.stdin.on('error')
            }
        }

        // Permettre à l'utilisateur d'interagir directement avec l'agent (pour coller le code d'auth par exemple)
        rl.pause();
        process.stdin.pipe(agent.stdin);

        let isWriteupMode = false;
        let writeupContent = "";

        agent.stdout.on('data', async (data) => {
            const output = data.toString();
            // On écrit la sortie brute pour ne pas casser l'interface (spinners, couleurs)
            process.stdout.write(data);

            if (isWriteupMode) {
                writeupContent += output;
                if (output.includes('=== END WRITEUP ===')) {
                    const filename = `Writeup_Mission_${challengeId}.md`;
                    // 1. Sauvegarde locale
                    fs.writeFileSync(filename, writeupContent);
                    console.log(`\n\x1b[32m[hlb]\x1b[0m ✅ Writeup sauvegardé localement : ${filename}`);
                    // 2. Sauvegarde en BD partagée
                    const saved = await saveWriteupToDB(challengeId, mission, writeupContent);
                    if (saved) {
                        console.log(`\x1b[32m[hlb]\x1b[0m ✅ Writeup synchronisé en BD (disponible pour toute la team) !`);
                    } else {
                        console.log(`\x1b[33m[hlb]\x1b[0m ⚠️  BD non disponible — writeup conservé uniquement en local.`);
                    }
                    agent.kill();
                    resolve();
                }
                return;
            }

            if (output.includes('=== BEGIN WRITEUP ===')) {
                isWriteupMode = true;
                writeupContent += output;
                return;
            }

            const flagMatch = output.match(/\[SUBMIT_FLAG\]\s*([^\s]+)/);
            if (flagMatch) {
                const flag = flagMatch[1];
                console.log(`\n\x1b[33m[hlb]\x1b[0m Flag intercepté : ${flag}. Vérification en cours...`);
                const isCorrect = await apiSubmitFlag(challengeId, flag);

                if (isCorrect) {
                    console.log(`\x1b[32m[hlb]\x1b[0m ✅ FLAG CORRECT ! Demande du writeup à l'agent...`);
                    agent.stdin.write('GENERATE_WRITEUP\n');
                } else {
                    console.log(`\x1b[31m[hlb]\x1b[0m ❌ FLAG INCORRECT.`);
                    agent.stdin.write('FLAG_INCORRECT_TRY_AGAIN\n');
                }
            }
        });

        agent.stderr.on('data', (data) => {
            process.stderr.write(`\x1b[31m[AGENT ERROR]\x1b[0m ${data}`);
        });

        agent.on('close', (code) => {
            console.log(`\x1b[33m[hlb]\x1b[0m L'agent IA s'est terminé avec le code ${code}.`);
            process.stdin.unpipe(agent.stdin);
            rl.resume();
            resolve();
        });
    });
}

async function handleAdminLicence(secret, action, arg1) {
    try {
        const body = { admin_secret: secret, action };
        if (action === 'create') body.owner = arg1 || 'anonymous';
        if (action === 'revoke' || action === 'activate') body.key = arg1;

        const res = await fetch(`${API_LICENCE_URL}/api/revoke`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        });

