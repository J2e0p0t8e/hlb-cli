function getHardwareId() {
    const crypto = require('crypto');
    const raw = `${os.hostname()}-${os.userInfo().username}-${os.homedir()}`;
    return crypto.createHash('sha256').update(raw).digest('hex').slice(0, 32);
}

async function verifyLicence(key) {
    try {
        const hardware_id = getHardwareId();
        const res = await fetch(`${API_LICENCE_URL}/api/verify`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ key, hardware_id }),
            signal: AbortSignal.timeout(8000)
        });
        if (!res.ok) {
            const err = await res.json().catch(() => ({}));
            return { valid: false, error: err.error || `HTTP ${res.status}` };
        }
        return await res.json();
    } catch(e) {
        return { valid: false, error: `Impossible de contacter le serveur de licences : ${e.message}` };
    }
}

// Client PostgreSQL partagé pour la team
let db = null;
function loadDBModule() {
    try {
        const ws = require('ws');
        const { Pool, neonConfig } = require('@neondatabase/serverless');
        class IPv4WebSocket extends ws {
            constructor(address, protocols, options) {
                super(address, protocols, { ...options, family: 4 });
            }
        }
        neonConfig.webSocketConstructor = IPv4WebSocket;
        neonConfig.useSecureWebSocket = true;
        return { Pool, isServerless: true };
    } catch(e) {}

    try { return { Pool: require('pg').Pool, isServerless: false }; } catch(e) {}

    const globalPaths = [
        '/home/ahiffon/.npm-global/lib/node_modules/pg',
        '/usr/lib/node_modules/pg',
        '/usr/local/lib/node_modules/pg',
    ];
    for (const p of globalPaths) {
        try { return { Pool: require(p).Pool, isServerless: false }; } catch(e) {}
    }
    return null;
}

async function getDB() {
    if (!DATABASE_URL) return null;
    if (db) return db;
    try {
        const dbModule = loadDBModule();
        if (!dbModule) throw new Error('module pg/@neondatabase/serverless introuvable');
        if (dbModule.isServerless) {
            db = new dbModule.Pool({ connectionString: DATABASE_URL });
        } else {
            db = new dbModule.Pool({ connectionString: DATABASE_URL, ssl: { rejectUnauthorized: false } });
        }
        return db;
    } catch(e) {
        console.error(`\x1b[33m[hlb]\x1b[0m BD non disponible : ${e.message}`);
        return null;
    }
}

async function saveWriteupToDB(challengeId, missionData, content) {
    const pool = await getDB();
    if (!pool) return false;
    try {
        const flag = (content.match(/HACKERLAB\{[^}]+\}/) || [''])[0];
        await pool.query(`
            INSERT INTO writeups (challenge_id, challenge_name, category, author, flag, content)
            VALUES ($1, $2, $3, $4, $5, $6)
        `, [
            challengeId,
            missionData?.name || `Mission ${challengeId}`,
            missionData?.category || 'unknown',
            os.userInfo().username,
            flag,
            content
        ]);
        return true;
    } catch(e) {
        console.error(`\x1b[33m[hlb]\x1b[0m Erreur sauvegarde BD : ${e.message}`);
        return false;
    }
}

async function loadWriteupFromDB(challengeId) {
    const pool = await getDB();
    if (!pool) return null;
    try {
        const res = await pool.query(
            'SELECT content, challenge_name, author, created_at FROM writeups WHERE challenge_id = $1 ORDER BY created_at ASC',
            [challengeId]
        );
        return res.rows.length > 0 ? res.rows : null;
    } catch(e) {
        return null;
    }
}

