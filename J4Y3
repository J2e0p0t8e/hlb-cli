            console.log(`\n=== 📋 Liste des Licences WhY_N07_Gh05T ===`);
            console.log("Clé\t\t\t\tStatut\tPropriétaire\tDernière activité");
            console.log("-".repeat(70));
            data.licences.forEach(lic => {
                const status = lic.active ? '\x1b[32mACTIVE\x1b[0m' : '\x1b[31mRÉVOQUÉE\x1b[0m';
                const lastSeen = lic.last_seen ? new Date(lic.last_seen).toLocaleString() : 'Jamais';
